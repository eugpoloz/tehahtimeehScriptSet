{
  "name": "tehahtimeeh-monorepo",
  "private": true,
  "packageManager": "yarn@4.17.1",
  "workspaces": [
    "lib/*",
    "scripts/*"
  ],
  "scripts": {
    "build": "make build",
    "clean": "make clean",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"lib/**/*.{js,json}\" \"scripts/**/*.{js,json}\" \"tooling/**/*.{js,mjs}\" \"*.{js,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "prettier": {
    "tabWidth": 2,
    "useTabs": false,
    "trailingComma": "none"
  }
}
